# Copiază acest fișier ca .env (în rădăcina proiectului; .env e ignorat de git) și completează valorile.
# Nu pune niciodată valorile în notebook-uri, loguri sau commit-uri.

# WEkEO (HDA) — tokenul din portal SAU numele de utilizator și parola contului
WEKEO_TOKEN=
WEKEO_USER=
WEKEO_PASSWORD=

# Copernicus Land Monitoring Service — calea către cheia de serviciu JSON (fișierul rămâne doar pe PC)
CLMS_KEY_PATH=data/private/clms_service_key.json
